# Copy to deploy/.env.dev on the host (never commit the real file).
COMPOSE_PROJECT_NAME=ninanatur-dev
REGISTRY=ghcr.io
OWNER=janderhungrige
IMAGE=ninanatur
IMAGE_TAG=dev
APP_PORT=4001
NINANATUR_ENV=dev

# Fine-grained personal access token with *only* "Issues: read and write" on
# JanderHungrige/NinaNatur. Leave it out and feedback is still collected on the
# volume — it simply is not filed.
NINANATUR_GITHUB_TOKEN=
NINANATUR_GITHUB_REPO=JanderHungrige/NinaNatur
