# MDD audit reports (ephemeral — regenerated by /mdd audit)
.mdd/audits/
# MDD active jobs (ephemeral — deleted on completion)
.mdd/jobs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Secrets — real env files never, templates always
.env
deploy/.env.*
!deploy/.env.*.example

# Data — never commit downloaded source dumps or the built DB
data/raw/
data/cache/
*.sqlite
*.sqlite3
*.db
# SQLite side files — a journal/WAL is as much data as the DB itself
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal

# Frontend
frontend/node_modules/
frontend/dist/
# Built frontend copied in for the container image
ninanatur/web/dist/
frontend/openapi.json
