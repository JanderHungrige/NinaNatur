# MDD audit reports (ephemeral — regenerated by /mdd audit)
.mdd/audits/
# MDD active jobs (ephemeral — deleted on completion)
.mdd/jobs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Secrets — real env files never, templates always
.env
deploy/.env.*
!deploy/.env.*.example

# Data — never commit downloaded source dumps or the built DB
data/raw/
data/cache/
*.sqlite
*.sqlite3
*.db
# SQLite side files — a journal/WAL is as much data as the DB itself
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal

# ...except the shipped runtime catalogue. Negations must come after every
# pattern they override, or the later *.sqlite rules win and it stays ignored.
#
# 10 MB of binary in git is a deliberate trade: the alternative is a release
# asset fetched at image build, which adds an external dependency to a build
# that currently needs none. The catalogue changes when its upstream sources do
# — roughly yearly — so few versions will accumulate. Revisit if that changes.
!ninanatur/data/catalogue.sqlite

# Frontend
frontend/node_modules/
frontend/dist/
# Built frontend copied in for the container image
ninanatur/web/dist/
frontend/openapi.json
