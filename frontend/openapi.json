        ]
      }
    },
    "/api/v1/gardens/{token}/obstacles": {
      "post": {
        "description": "Add an obstacle and recompute in the same call.\n\nRequiring a second request would leave the plan showing light values that no\nlonger match its own obstacles \u2014 and nothing would make that visible.",
        "operationId": "create_obstacle_api_v1_gardens__token__obstacles_post",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
