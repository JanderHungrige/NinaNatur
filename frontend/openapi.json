              "anyOf": [
                {
                  "maximum": 10,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Nutrients"
            }
          },
          {
            "in": "query",
            "name": "reaction",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 10,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Reaction"
            }
          },
          {
            "in": "query",
            "name": "temperature",
            "required": false,
            "schema": {
              "anyOf": [
                {
