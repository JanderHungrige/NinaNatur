    "/api/v1/plants": {
      "get": {
        "description": "Species ranked by how well they fit the given site conditions.",
        "operationId": "search_plants_api_v1_plants_get",
        "parameters": [
          {
            "in": "query",
            "name": "light",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 10,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Light"
            }
          },
          {
            "in": "query",
            "name": "moisture",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 10,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Moisture"
            }
          },
          {
            "in": "query",
            "name": "nutrients",
            "required": false,
