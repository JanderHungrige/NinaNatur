      "post": {
        "description": "Add a bed. PolygonError, SoilTypeError and MoistureError all subclass\nValueError, so they surface as 422 with their reason rather than as a 500.",
        "operationId": "create_bed_api_v1_gardens__token__beds_post",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
