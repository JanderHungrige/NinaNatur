# What CI installs beside the image's lock: the tools, never the app's own
# dependencies. They are compiled against requirements.txt, and the dev lock
# then keeps only what the image's lock does not pin, so every package is pinned
# once and CI, installing both, tests what ships:
#
#   python scripts/compile_dev_lock.py      (needs uv)
pytest
# Refuses every socket that is not a Unix one, so no test can reach the network
# by accident (`pyproject.toml` addopts; `tests/test_no_network.py`).
pytest-socket
ruff
mypy
types-requests
types-defusedxml
httpx
pip-audit
